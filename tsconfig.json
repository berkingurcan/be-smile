{
  "extends": "$app/tsconfig",
  "include": ["src", "scripts", "*.ts"],
  "exclude": ["node_modules", "build", ".vercel"],
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "moduleResolution": "bundler"
  }
}
